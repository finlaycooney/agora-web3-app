NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-a-local-development-secret

# Optional. Direct candidate applications do not require GitHub OAuth.
# Use placeholders locally if you do not need to test GitHub sign-in.
GITHUB_ID=
GITHUB_SECRET=

# Optional. Required only by features that send email.
RESEND_API_KEY=
