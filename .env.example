NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-a-local-development-secret

# Optional. Not read by the app today (staff invites do not send email).
RESEND_API_KEY=

# Google OAuth — the only sign-in provider (staff workspace and invite claims).
# Staff access is limited to Google-verified @agora4.xyz accounts.
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Staff database access for resolving staff principals (server-only).
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: a login role that can only SET ROLE app_staff, through the
# Supabase transaction pooler. See docs/staff-workspace-launch.md.
# postgresql://agora_staff_runtime.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
STAFF_DATABASE_URL=
# Seeded staff organization UUID.
STAFF_ORGANIZATION_ID=9c4edd11-2571-490b-a87c-ef30b9e0a001

# Public intake database access — anonymous job board reads and application
# submissions (app_intake role, server-only).
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: a login role that can only SET ROLE app_intake, through the
# Supabase transaction pooler. See docs/staff-workspace-launch.md.
# postgresql://agora_intake_runtime.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
INTAKE_DATABASE_URL=
